id = "audio"
name = "Audio"
description = "Default output volume and mute HUD"
command = ["@CMAKE_INSTALL_FULL_BINDIR@/gisland-lua-host"]
entry = "audio.lua"
config = "config.toml"

[protocol]
major = 1
minimum_minor = 8
maximum_minor = 8

[options_schema.step_percent]
type = "integer"
minimum = 1
maximum = 25

[options_schema.maximum_percent]
type = "integer"
minimum = 100
maximum = 200

[options_schema.hud_duration_ms]
type = "integer"
minimum = 100
maximum = 60000
