id = "notifications"
name = "Desktop Notifications"
description = "Freedesktop notification service for gisland"
command = ["@CMAKE_INSTALL_FULL_BINDIR@/gisland-lua-host"]
entry = "notifications.lua"

[protocol]
major = 1
minimum_minor = 8
maximum_minor = 8

[defaults]
reveal_duration_ms = 1000
history_limit = 100
history_visible_limit = 5

[options_schema.reveal_duration_ms]
type = "integer"

[options_schema.history_limit]
type = "integer"

[options_schema.history_visible_limit]
type = "integer"
