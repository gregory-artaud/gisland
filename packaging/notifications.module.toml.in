id = "notifications"
name = "Desktop Notifications"
description = "Freedesktop notification service for gisland"
command = ["@CMAKE_INSTALL_FULL_BINDIR@/gisland-notifications"]

[protocol]
major = 1
minimum_minor = 4
maximum_minor = 4

[defaults]
reveal_duration_ms = 1000

[options_schema.reveal_duration_ms]
type = "integer"
