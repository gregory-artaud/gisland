#!/usr/bin/env python3
import json
import os
import signal
import sys
import time
from pathlib import Path


state_path = Path(os.environ["GISLAND_AUDIO_FAKE_STATE"])
log_path = Path(os.environ["GISLAND_AUDIO_COMMAND_LOG"])
command = sys.argv[1:]

with log_path.open("a", encoding="utf-8") as stream:
    stream.write(
        json.dumps(
            {
                "program": "pactl",
                "argv": command,
                "lc_all": os.environ.get("LC_ALL"),
            },
            sort_keys=True,
        )
        + "\n"
    )

state = json.loads(state_path.read_text(encoding="utf-8"))
key = " ".join(command)
if state.get("sleep_once") == key:
    state["sleep_once"] = None
    state_path.write_text(json.dumps(state), encoding="utf-8")
    time.sleep(float(state.get("sleep_seconds", 3)))
if state.get("ignore_sigterm_once") == key:
    state["ignore_sigterm_once"] = None
    state_path.write_text(json.dumps(state), encoding="utf-8")
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    while True:
        time.sleep(1)
if state.get("fail_once") == key:
    state["fail_once"] = None
    state_path.write_text(json.dumps(state), encoding="utf-8")
    print(state.get("failure_message", "fake pactl failure"), file=sys.stderr)
    raise SystemExit(1)

if command == ["get-sink-volume", "@DEFAULT_SINK@"]:
    channels = state["volume_reads"].pop(0)
    state_path.write_text(json.dumps(state), encoding="utf-8")
    rendered = ", ".join(
        f"channel-{index}: 65536 / {value}% / 0.00 dB"
        for index, value in enumerate(channels)
    )
    print(f"Volume: {rendered}")
elif command == ["get-sink-mute", "@DEFAULT_SINK@"]:
    muted = state["mute_reads"].pop(0)
    state_path.write_text(json.dumps(state), encoding="utf-8")
    print("Mute: yes" if muted else "Mute: no")
elif len(command) == 3 and command[:2] == ["set-sink-volume", "@DEFAULT_SINK@"]:
    if not command[2].endswith("%") or not command[2][:-1].isdigit():
        raise SystemExit("invalid fake volume")
elif len(command) == 3 and command[:2] == ["set-sink-mute", "@DEFAULT_SINK@"]:
    if command[2] not in ("0", "1"):
        raise SystemExit("invalid fake mute")
else:
    raise SystemExit(f"unexpected pactl command: {command!r}")
