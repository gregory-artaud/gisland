#!/usr/bin/env python3
import json
import os
import signal
import sys
import time
from pathlib import Path


log_path = Path(os.environ["GISLAND_AUDIO_COMMAND_LOG"])
with log_path.open("a", encoding="utf-8") as stream:
    stream.write(
        json.dumps(
            {
                "program": "gislandctl",
                "argv": sys.argv[1:],
                "lc_all": os.environ.get("LC_ALL"),
            },
            sort_keys=True,
        )
        + "\n"
    )

started_marker = os.environ.get("GISLAND_AUDIO_FAKE_GISLANDCTL_STARTED")
if started_marker:
    Path(started_marker).touch()
release_marker = os.environ.get("GISLAND_AUDIO_FAKE_GISLANDCTL_RELEASE")
while release_marker and not Path(release_marker).exists():
    time.sleep(0.01)
if os.environ.get("GISLAND_AUDIO_FAKE_GISLANDCTL_IGNORE_SIGTERM"):
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    while True:
        time.sleep(1)
if os.environ.get("GISLAND_AUDIO_FAKE_GISLANDCTL_SLEEP"):
    time.sleep(float(os.environ["GISLAND_AUDIO_FAKE_GISLANDCTL_SLEEP"]))
if os.environ.get("GISLAND_AUDIO_FAKE_GISLANDCTL_FAIL"):
    print("fake gislandctl failure", file=sys.stderr)
    raise SystemExit(1)
if sys.argv[1:] != ["close"]:
    raise SystemExit(f"unexpected gislandctl command: {sys.argv[1:]!r}")
real_gislandctl = os.environ.get("GISLAND_AUDIO_REAL_GISLANDCTL")
if real_gislandctl:
    os.execv(real_gislandctl, [real_gislandctl, *sys.argv[1:]])
